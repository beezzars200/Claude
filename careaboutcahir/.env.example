# Railway injects DATABASE_URL / MYSQL_URL automatically when you attach a MySQL
# database to this service. For local dev, either set DATABASE_URL directly or
# fill in the DB_* fields below.
DATABASE_URL=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=careaboutcahir
DB_PORT=3306

SESSION_SECRET=change_this_to_a_long_random_string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

PORT=3000
SITE_NAME=Care About Cahir
