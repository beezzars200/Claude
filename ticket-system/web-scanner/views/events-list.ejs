<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Events — UMN Tickets</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="events-page">
  <header class="site-header">
    <div class="container site-header-row">
      <div>
        <h1>Events</h1>
        <p>Select an event to begin scanning tickets</p>
      </div>
      <div class="site-header-user">
        <span class="site-header-username"><%= username %></span>
        <% if (isSuperAdmin) { %><a href="/manage" class="header-link">Manage</a><% } %>
        <a href="/auth/logout" class="header-link">Logout</a>
      </div>
    </div>
  </header>
  <main class="container">
    <% if (!events.length) { %>
      <div class="empty-state">
        <p>No active events at the moment.</p>
      </div>
    <% } else { %>
      <div class="events-grid">
        <% events.forEach(event => { %>
          <a href="/events/<%= event.slug %>/scan" class="event-card">
            <div class="event-card-top" style="background: <%= event.accent_color %>"></div>
            <% if (event.logo_url) { %>
              <img src="<%= event.logo_url %>" alt="<%= event.org_name %>" class="event-logo">
            <% } %>
            <div class="event-card-body">
              <p class="event-org"><%= event.org_name %></p>
              <h2><%= event.name %></h2>
              <p class="event-meta">
                <%= new Date(event.event_date).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                <% if (event.event_time) { %> &middot; <%= event.event_time %><% } %>
              </p>
              <% if (event.venue) { %><p class="event-venue"><%= event.venue %></p><% } %>
            </div>
            <div class="event-card-stats">
              <div class="event-stat">
                <span class="event-stat-num"><%= event.total_tickets || 0 %></span>
                <span class="event-stat-label">Tickets</span>
              </div>
              <div class="event-stat">
                <span class="event-stat-num"><%= event.scanned_tickets || 0 %></span>
                <span class="event-stat-label">Scanned</span>
              </div>
              <div class="event-stat">
                <span class="event-stat-num"><%= (parseInt(event.total_tickets) || 0) - (parseInt(event.scanned_tickets) || 0) %></span>
                <span class="event-stat-label">Remaining</span>
              </div>
            </div>
            <div class="event-card-footer">
              <span class="scan-btn">Open Scanner &rarr;</span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
